##--------- Scaling and Dummy variables for Clustering ----------------

cat("------------ SCALING AND DUMMY VARIABLES ------------\n")

# Create dummy variables for categorical fields
train_hmeq_dum <- fastDummies::dummy_cols(
  train_hmeq_mR_imp,
  select_columns = c("JOB", "REASON"),
  remove_first_dummy = TRUE,
