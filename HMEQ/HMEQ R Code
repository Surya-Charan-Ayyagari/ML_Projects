##--------- Train-Test Split ---------------


cat("------------ TRAIN-TEST SPLIT ------------\n")
set.seed(2026)
# Split data into training and testing sets using stratified sampling on BAD
idx <- createDataPartition(hmeq_data$BAD, p = 0.7, list = FALSE)
train_hmeq <- hmeq_data[idx, ]
test_hmeq  <- hmeq_data[-idx, ]

cat("Training set dimensions:", nrow(train_hmeq), "rows and", ncol(train_hmeq), "columns\n")
cat("Testing set dimensions :", nrow(test_hmeq), "rows and", ncol(test_hmeq), "columns\n\n")

