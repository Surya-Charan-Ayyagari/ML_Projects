##--------- Missing Data Imputation -------------


cat("------------ MISSING DATA IMPUTATION ------------\n")

# Impute missing values using missRanger
library(missRanger)
set.seed(2026)
cat("Running missRanger imputation...\n")
imp_mR_model <- missRanger(train_hmeq[,-1],formula = . ~ . , keep_forests = TRUE)

# Extract the completed dataset from missRanger
train_hmeq_mR_imp <- imp_mR_model$data
cat("missRanger imputation completed.\n\n")

# Round selected discrete variables after missRanger imputation
discrete_vars <- c("DELINQ", "DEROG", "NINQ", "CLNO", "YOJ")
train_hmeq_mR_imp[, discrete_vars] <- round(train_hmeq_mR_imp[, discrete_vars], 0)

# Variables to compare across imputation methods
cont_var <- c("LOAN", "MORTDUE", "VALUE", "YOJ", "CLAGE", "DEBTINC",
              "DELINQ", "DEROG", "CLNO", "NINQ")

# Compare original and imputed distributions using boxplots
par(mfrow = c(3, 3), mar = c(4, 4, 2, 1))
for (v in cont_var) {
  boxplot(train_hmeq[[v]],
          train_hmeq_mR_imp[[v]],
          names = c("Original", "missRanger"),
          main = paste("Boxplot of", v),
          col = c("lightgray", "mistyrose"),
          ylab = v)
}
par(mfrow = c(1, 1))

train_hmeq_mR_imp$BAD <- train_hmeq$BAD

# Compare correlation structures across original and imputed dataset
cor_original <- cor(train_hmeq[, sapply(train_hmeq, is.numeric)], use = "complete.obs")
cor_mr <- cor(train_hmeq_mR_imp[, sapply(train_hmeq_mR_imp, is.numeric)])

cat("Correlation matrix - Original data:\n")
print(round(cor_original, 2))
cat("\n")

cat("Correlation matrix - missRanger imputed data:\n")
print(round(cor_mr, 2))
cat("\n")

# Impute Test Data Using Trained missRanger Model


cat("------------ TEST DATA IMPUTATION ------------\n")

# Make sure categorical variables in test data have the same type as training data
test_hmeq$REASON <- as.factor(test_hmeq$REASON)
test_hmeq$JOB <- as.factor(test_hmeq$JOB)

# Keep factor levels consistent with training data
test_hmeq$REASON <- factor(test_hmeq$REASON, levels = levels(train_hmeq$REASON))
test_hmeq$JOB    <- factor(test_hmeq$JOB, levels = levels(train_hmeq$JOB))

# Check the missing values in test data
cat("Missing values in test data before imputation:\n")
print(colSums(is.na(test_hmeq)))
cat("\n")

# Impute the test data using the trained missRanger model
test_hmeq_mR_imp <- predict(imp_mR_model, test_hmeq)

# Check whether any missing values remain
cat("Missing values in test data after imputation:\n")
print(colSums(is.na(test_hmeq_mR_imp)))
cat("\n")

# Round imputed discrete variables to whole numbers
discrete_vars <- c("DELINQ", "DEROG", "NINQ", "CLNO", "YOJ")
test_hmeq_mR_imp[, discrete_vars] <- round(test_hmeq_mR_imp[, discrete_vars], 0)

# Review summary of the imputed test data
cat("Summary of imputed test data:\n")
print(summary(test_hmeq_mR_imp))
cat("\n")

