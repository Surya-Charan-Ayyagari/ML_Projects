#------------Apply Clusters to test data --------------
assign_kmeans_cluster <- function(new_data, centers) {
  new_mat <- as.matrix(new_data)
  centers_mat <- as.matrix(centers)
  
  assigned_cluster <- apply(new_mat, 1, function(x) {
    dists <- apply(centers_mat, 1, function(center) {
      sum((x - center)^2)
    })
    which.min(dists)
  })
  
  return(assigned_cluster)
}

